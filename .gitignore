# Project-specific
paper/
logs/
trajectory_runs/
hf_dataset/
export_trajectories.py
results-analysis/

# Reproducible large derived data files
traj_retrieval/evaluation/ltr_data/**/*disagreements*.json
traj_retrieval/evaluation/ltr_data/**/*simulation_compare*.json
# Orphan raw-split dumps from earlier experiment runs; no script reads them
# and the WebArena entries embed live hostnames. Regenerate locally if needed.
traj_retrieval/evaluation/ltr_data/raw_splits/

# no_retrieval_runs JSONs feed the simulate_till_tk /
# pseudo_simulate_till_closest_tk strategies. Ship the two canonical
# per-env files; keep experiment-specific runs local.
traj_retrieval/preprocess/no_retrieval_runs/*.json
!traj_retrieval/preprocess/no_retrieval_runs/alfworld_no_retrieval_runs_results.json
!traj_retrieval/preprocess/no_retrieval_runs/webarena_no_retrieval_runs_results.json
traj_retrieval/preprocess/no_retrieval_runs/openrouter34_s42_webarena/

# Experiment-specific split allocations
traj_retrieval/preprocess/new_splits/alfworld/official_test/openrouter34_rr_s42/
traj_retrieval/preprocess/new_splits/alfworld/simulation/openrouter34_s42/
traj_retrieval/preprocess/new_splits/alfworld/train/openrouter34_s42/
traj_retrieval/preprocess/new_splits/webarena/simulation/openrouter34_s42/
traj_retrieval/preprocess/new_splits/webarena/train/openrouter34_s42/

# Generated analysis outputs (reproducible)
traj_retrieval/evaluation/analysis/pairwise_ltr_analysis.json
traj_retrieval/evaluation/analysis/utility_retrieval_analysis.json
traj_retrieval/evaluation/analysis/paired_tests/paired_t_test_results.json
traj_retrieval/preprocess/new_splits/**/*_report.json
traj_retrieval/preprocess/new_splits/**/*_manifest.json
traj_retrieval/evaluation/ltr_data/**/similarity_distributions.png
traj_retrieval/evaluation/ltr_data/**/similarity_analysis.json

# Local LTR variants that don't ship; the canonical ltr/data_out/{alfworld,webarena}/
# TSVs ARE tracked so the retrieval runtime can read feature column order.
ltr/data_out_llm_features_new/

# Environment data is generated by setup_environments.py and per-run scripts,
# so it's gitignored — except for the canonical ALFWorld config that the
# runner needs at startup (loaded by traj_retrieval/core/alfworld_handler.py).
.env
environments/*
!environments/alfworld/
environments/alfworld/*
!environments/alfworld/base_config.yaml

