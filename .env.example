# MATM environment configuration
# Copy this file to .env and edit the values for your setup.

# Root directory for environment data, indices, and trajectory logs.
# Preprocess, index-build, and evaluation scripts resolve paths relative
# to this root (e.g., ${MATM_DATA_ROOT}/train_only_lancedb/alfworld/lancedb_indices).
MATM_DATA_ROOT=./environments

# OpenRouter API key (required for LLM-based evaluation)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# WebArena hostname (required only for WebArena evaluation)
# WEBARENA_HOST=your-webarena-host.example.com

# Absolute path to your local clone of the upstream WebArena repo, used by
# run_webarena.py to import the upstream `browser_env` package
# (required only for WebArena evaluation; see requirements-webarena.txt).
# WEBARENA_RENEW_WEBARENA_PATH=/abs/path/to/webarena

# Push successful runtime trajectories into the shared LanceDB index (0/1)
# ONLINE_MEMORY_ENABLED=0

# SVMRank binaries (shipped in ltr/svm_rank/; override if installed elsewhere)
# SVMRANK_BIN_DIR=./ltr/svm_rank

# Optional overrides for LTR data-generation scripts
# ALFWORLD_LANCEDB_PATH=${MATM_DATA_ROOT}/train_only_lancedb/alfworld/lancedb_indices
# WEBARENA_LANCEDB_PATH=${MATM_DATA_ROOT}/train_only_lancedb/webarena/lancedb_indices
